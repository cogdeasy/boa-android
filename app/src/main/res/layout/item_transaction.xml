<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/row_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/row_padding">

    <TextView
        android:id="@+id/txn_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/txn_amount"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/nb_text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txn_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txn_description"
        android:layout_marginTop="2dp"
        android:textColor="@color/nb_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txn_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="12dp"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txn_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txn_amount"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:textColor="@color/nb_text_secondary"
        android:textSize="12sp" />
</RelativeLayout>
