<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.northbridge.mobile">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".NorthbridgeApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.login.LoginActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.accounts.AccountsActivity"
            android:label="@string/title_accounts" />

        <activity
            android:name=".ui.transactions.TransactionHistoryActivity"
            android:label="@string/title_activity"
            android:parentActivityName=".ui.accounts.AccountsActivity" />

        <activity
            android:name=".ui.transfer.TransferActivity"
            android:exported="true"
            android:label="@string/title_transfer"
            android:parentActivityName=".ui.accounts.AccountsActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="northbridge" android:host="transfer" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.payments.PaymentsActivity"
            android:label="@string/title_payments"
            android:parentActivityName=".ui.accounts.AccountsActivity" />

        <activity
            android:name=".ui.payments.BillPayActivity"
            android:label="@string/title_bill_pay"
            android:parentActivityName=".ui.payments.PaymentsActivity" />

        <activity
            android:name=".ui.payments.SendMoneyActivity"
            android:label="@string/title_send_money"
            android:parentActivityName=".ui.payments.PaymentsActivity" />

        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="true"
            android:label="@string/title_help">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="northbridge" android:host="help" />
            </intent-filter>
        </activity>
    </application>

</manifest>
